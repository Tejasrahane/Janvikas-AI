# JanVikas AI (Rashtriya Vikas Netram) - Environment Template
# -------------------------------------------------------------
# Instructions:
# 1. Copy this file and rename to `.env` or `.env.local`
# 2. Populate your local secrets below.
# 3. DO NOT commit `.env` or `.env.local` to Git.

# Google Maps API Key (Optional)
# If left blank, JanVikas automatically defaults to free Esri Photorealistic World Imagery and Sovereign Tactical Dark basemaps with zero watermarks.
VITE_GOOGLE_MAPS_API_KEY=

# Backend API Base URL
VITE_BACKEND_API_URL=http://localhost:8000
